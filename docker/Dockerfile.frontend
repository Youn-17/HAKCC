# HAKCC Frontend — Optimized for Alibaba Cloud
# Static files served via Nginx (tiny image, fast start)

# ── Stage 1: Build ──
FROM node:22.22.3-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci --ignore-scripts

COPY . .

ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_API_URL

RUN npm run build

# ── Stage 2: Serve with Nginx (alpine ~5MB) ──
FROM nginx:alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
