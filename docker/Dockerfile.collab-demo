FROM node:22.22.3-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY collab-demo.html vite.collab.config.ts ./
COPY collab/demo.tsx ./collab/demo.tsx
COPY components/CollaborativeDocumentEditor.* ./components/
COPY components/RemixIcon.tsx ./components/
COPY styles/remixicon ./styles/remixicon
COPY services/collaborativeDocuments.ts ./services/
RUN npx vite build --config vite.collab.config.ts
FROM nginx:1.28-alpine
COPY docker/nginx.collab-demo.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist-collab-demo /usr/share/nginx/html
EXPOSE 80
