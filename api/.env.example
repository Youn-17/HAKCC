PORT=4000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
FRONTEND_URL=http://localhost:3000
AUTH_RATE_LIMIT_MAX=50
API_RATE_LIMIT_MAX=1200
# Optional local collaboration service; keep disabled until the pilot is accepted.
COLLAB_ENABLED=false
COLLAB_INTERNAL_URL=http://127.0.0.1:4310
COLLAB_PUBLIC_WS_URL=ws://localhost:4310
COLLAB_SECRET=
# Optional. If omitted, the API derives encryption material from SUPABASE_JWT_SECRET.
AI_CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Optional. Jev (TypeSafe System One) for quick judgments. Without a key Jev is not used.
# Configuration and limitations: write/UPDATES_v0.3.0.en.md
JEV_API_KEY=
# off | shadow (judge alongside the current model, record only) | gate (Jev decides)
JEV_FEEDBACK_MODE=shadow
# Probability cut-offs: a clear gap (T1-T4, T6) / a promising unfinished idea (T5)
JEV_NEED_THRESHOLD=0.5
JEV_PROMISING_THRESHOLD=0.7
# on | off: use question depth to set how long AI answers are
JEV_ANSWER_LENGTH=on
# on | off: decide whether a chat message asks for a drawing (new or a change), which form, and check the plan
JEV_DRAWING=on
# Pinned so every judgment can be traced to a model version
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=4000

# Optional course knowledge base; server-side credentials only.
# Setup and data-use conditions: write/UPDATES_v0.4.0.en.md
KB_OPENROUTER_API_KEY=
MINERU_TOKEN=
# Optional DMX keep-warm, separate from course-material embeddings.
KB_DMX_API_KEY=
